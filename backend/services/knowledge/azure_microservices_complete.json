{
  "azure_microservices_complete": {
    "name": "Azure Microservices - Production Complete",
    "description": "Complete production-ready microservices architecture on Azure with ALL necessary components",
    "maturity": "production_ready",
    "minimum_components": 20,
    "required_layers": [
      "identity",
      "security",
      "connectivity", 
      "application",
      "data",
      "observability",
      "cicd",
      "secrets_management",
      "messaging"
    ],
    "layers": [
      {
        "name": "Identity & Access Management",
        "purpose": "Authentication and authorization for all services",
        "required": true,
        "components": {
          "azure": [
            "Microsoft Entra ID (Azure AD)",
            "Managed Identity",
            "App Registrations"
          ]
        }
      },
      {
        "name": "Security & Compliance",
        "purpose": "Threat protection, security monitoring, and compliance",
        "required": true,
        "components": {
          "azure": [
            "Azure Defender",
            "Microsoft Defender for Cloud",
            "Azure Policy",
            "Azure Security Center"
          ]
        }
      },
      {
        "name": "Global Connectivity & Ingress",
        "purpose": "Global traffic management and secure entry points",
        "required": true,
        "components": {
          "azure": [
            "Azure Front Door",
            "Azure CDN",
            "Azure Traffic Manager",
            "Azure DNS"
          ]
        }
      },
      {
        "name": "Network Security",
        "purpose": "Network-level security and traffic filtering",
        "required": true,
        "components": {
          "azure": [
            "Azure Firewall",
            "Network Security Groups (NSG)",
            "Azure DDoS Protection",
            "Azure Bastion"
          ]
        }
      },
      {
        "name": "Application Gateway & WAF",
        "purpose": "Layer 7 load balancing, SSL termination, Web Application Firewall",
        "required": true,
        "components": {
          "azure": [
            "Application Gateway",
            "Web Application Firewall (WAF)",
            "SSL/TLS Certificates"
          ]
        }
      },
      {
        "name": "Virtual Network Architecture",
        "purpose": "Network segmentation and isolation",
        "required": true,
        "components": {
          "azure": [
            "Hub VNet",
            "Spoke VNet (per workload)",
            "VNet Peering",
            "Private Endpoints",
            "Service Endpoints"
          ]
        }
      },
      {
        "name": "Container Infrastructure",
        "purpose": "Container registry and orchestration",
        "required": true,
        "components": {
          "azure": [
            "Azure Container Registry (ACR)",
            "Azure Kubernetes Service (AKS)",
            "Virtual Nodes",
            "Node Pools"
          ]
        }
      },
      {
        "name": "API Management",
        "purpose": "API gateway for external and internal API management",
        "required": true,
        "components": {
          "azure": [
            "Azure API Management",
            "Developer Portal",
            "Rate Limiting",
            "API Policies"
          ]
        }
      },
      {
        "name": "Microservices Layer",
        "purpose": "Individual microservices running in AKS",
        "required": true,
        "components": {
          "azure": [
            "Frontend Service (Web UI)",
            "API Gateway Service",
            "Auth Service",
            "User Service",
            "Order Service",
            "Payment Service",
            "Notification Service",
            "Background Workers"
          ],
          "patterns": [
            "Service Discovery (Kubernetes DNS)",
            "Health Checks (Readiness/Liveness Probes)",
            "Circuit Breakers",
            "Retry Policies"
          ]
        }
      },
      {
        "name": "Asynchronous Messaging",
        "purpose": "Event-driven communication between microservices",
        "required": true,
        "components": {
          "azure": [
            "Azure Service Bus",
            "Azure Event Hubs",
            "Azure Event Grid"
          ]
        }
      },
      {
        "name": "Data Storage",
        "purpose": "Persistent and scalable data storage",
        "required": true,
        "components": {
          "azure": [
            "Azure Cosmos DB",
            "Azure SQL Database",
            "Azure Cache for Redis",
            "Azure Blob Storage"
          ]
        }
      },
      {
        "name": "Secrets & Configuration",
        "purpose": "Secure management of secrets, keys, and configuration",
        "required": true,
        "components": {
          "azure": [
            "Azure Key Vault",
            "Azure App Configuration",
            "Managed Identity integration"
          ]
        }
      },
      {
        "name": "Observability - Monitoring",
        "purpose": "Comprehensive monitoring of infrastructure and applications",
        "required": true,
        "components": {
          "azure": [
            "Azure Monitor",
            "Application Insights",
            "Container Insights",
            "Metrics Explorer"
          ]
        }
      },
      {
        "name": "Observability - Logging",
        "purpose": "Centralized log collection and analysis",
        "required": true,
        "components": {
          "azure": [
            "Log Analytics Workspace",
            "Diagnostic Settings",
            "Log Queries (KQL)"
          ]
        }
      },
      {
        "name": "Observability - Tracing",
        "purpose": "Distributed tracing across microservices",
        "required": true,
        "components": {
          "azure": [
            "Application Insights Distributed Tracing",
            "Open Telemetry",
            "Correlation IDs"
          ]
        }
      },
      {
        "name": "Alerting & Incident Management",
        "purpose": "Proactive alerting and incident response",
        "required": true,
        "components": {
          "azure": [
            "Azure Monitor Alerts",
            "Action Groups",
            "Smart Detection",
            "PagerDuty/Slack integration"
          ]
        }
      },
      {
        "name": "CI/CD Pipeline",
        "purpose": "Automated build, test, and deployment",
        "required": true,
        "components": {
          "azure": [
            "Azure DevOps Pipelines",
            "GitHub Actions",
            "Azure Container Registry Tasks",
            "GitOps (ArgoCD/Flux)"
          ]
        }
      },
      {
        "name": "Scaling & Performance",
        "purpose": "Auto-scaling and performance optimization",
        "required": true,
        "components": {
          "azure": [
            "Horizontal Pod Autoscaler (HPA)",
            "Cluster Autoscaler",
            "KEDA (Event-driven autoscaling)",
            "Azure Load Testing"
          ]
        }
      },
      {
        "name": "Disaster Recovery & Backup",
        "purpose": "Business continuity and data protection",
        "required": true,
        "components": {
          "azure": [
            "Azure Backup",
            "Geo-replication (Cosmos DB)",
            "Multi-region deployment",
            "Azure Site Recovery"
          ]
        }
      },
      {
        "name": "Cost Management",
        "purpose": "Cost optimization and monitoring",
        "required": false,
        "components": {
          "azure": [
            "Azure Cost Management",
            "Budget Alerts",
            "Reserved Instances",
            "Spot Instances"
          ]
        }
      }
    ],
    "best_practices": [
      "Use Managed Identity for all service-to-service authentication",
      "Implement health checks (readiness and liveness probes) for all microservices",
      "Use Azure API Management as the single entry point for all APIs",
      "Implement distributed tracing with correlation IDs",
      "Use Azure Service Bus for asynchronous inter-service communication",
      "Store all secrets in Azure Key Vault, never in code or configuration",
      "Implement circuit breakers and retry policies for resilience",
      "Use Azure Front Door for global load balancing and DDoS protection",
      "Enable Container Insights for AKS monitoring",
      "Implement GitOps for infrastructure and application deployment",
      "Use network policies in AKS to control pod-to-pod communication",
      "Enable Azure Defender for all resources",
      "Implement proper RBAC with least privilege principle",
      "Use separate subscriptions for different environments (dev, staging, prod)",
      "Implement automated backup and disaster recovery procedures"
    ],
    "connections": [
      "User -> Azure Front Door -> Azure Firewall -> Application Gateway -> AKS (Frontend Service)",
      "Frontend Service -> Azure API Management -> Backend Microservices",
      "Microservices -> Azure Service Bus -> Other Microservices (async)",
      "Microservices -> Azure Key Vault (via Managed Identity) -> Secrets",
      "Microservices -> Azure Cosmos DB / SQL Database -> Data",
      "Microservices -> Azure Cache for Redis -> Cached Data",
      "All Services -> Application Insights -> Distributed Tracing",
      "All Services -> Log Analytics -> Centralized Logging",
      "Azure Monitor -> Action Groups -> Alerts/Notifications",
      "CI/CD Pipeline -> ACR -> AKS Deployments"
    ]
  }
}
